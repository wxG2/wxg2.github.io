---
import type { Lang } from '../data/site';
import { profile } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const isZh = lang === 'zh';
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div>
      <p class="footer-kicker">{isZh ? '保持联系' : 'Stay in touch'}</p>
      <p>{isZh ? '如果你也在构建可靠的 AI 系统，欢迎交流。' : 'If you are building reliable AI systems too, let’s talk.'}</p>
    </div>
    <div class="footer-links">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
    <p class="footer-meta">© 2026 Weixiang Gao · {isZh ? '杭州' : 'Hangzhou'}</p>
  </div>
</footer>
