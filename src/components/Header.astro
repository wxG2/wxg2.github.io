---
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const isZh = lang === 'zh';
const home = isZh ? '/' : '/en/';
const nav = isZh
  ? [
      ['#work', '项目'],
      ['#research', '研究'],
      ['#experience', '经历'],
      ['#contact', '联系'],
    ]
  : [
      ['#work', 'Work'],
      ['#research', 'Research'],
      ['#experience', 'Experience'],
      ['#contact', 'Contact'],
    ];
---

<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="wordmark" href={home} aria-label={isZh ? 'WG/26 · 返回高伟翔主页' : 'WG/26 · Back to Weixiang Gao home'}>
      <span class="wordmark-dot" aria-hidden="true"></span>
      <span>WG<span class="wordmark-slash">/</span>26</span>
    </a>
    <nav class="main-nav" aria-label={isZh ? '主要导航' : 'Primary navigation'}>
      {nav.map(([href, label]) => <a href={`${home}${href}`}>{label}</a>)}
    </nav>
    <a class="language-switch" href={alternatePath} hreflang={isZh ? 'en' : 'zh-CN'}>
      <span>{isZh ? 'EN' : '中文'}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
