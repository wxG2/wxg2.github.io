---
import type { Lang, Project } from '../data/site';
import Header from './Header.astro';
import Footer from './Footer.astro';

const { lang, project } = Astro.props as { lang: Lang; project: Project };
const isZh = lang === 'zh';
const home = isZh ? '/' : '/en/';
const alternatePath = isZh ? `/en/work/${project.slug}/` : `/work/${project.slug}/`;
const labels = isZh
  ? { back: '返回全部项目', challenge: '问题', role: '我的职责', approach: '方案', outcomes: '成果', stack: '技术栈', evidence: '证据与链接', flow: '系统路径', enterprise: '企业项目，公开信息已脱敏。', next: '继续浏览' }
  : { back: 'Back to all work', challenge: 'Challenge', role: 'My role', approach: 'Approach', outcomes: 'Outcomes', stack: 'Stack', evidence: 'Evidence & links', flow: 'System path', enterprise: 'Enterprise project. Public details are intentionally limited.', next: 'Keep exploring' };
---

<Header lang={lang} alternatePath={alternatePath} />

<main id="main-content" class={`work-detail work-detail--${project.accent}`}>
  <section class="work-hero shell">
    <a class="back-link" href={`${home}#work`}><span aria-hidden="true">←</span>{labels.back}</a>
    <div class="work-hero-grid">
      <div data-reveal class="is-visible">
        <div class="work-kicker"><span>{project.index}</span><span>{project.eyebrow[lang]}</span></div>
        <h1>{project.title[lang]}</h1>
        <p class="work-summary">{project.summary[lang]}</p>
        <div class="work-tags">
          {project.stack.slice(0, 4).map((item) => <span>{item}</span>)}
        </div>
      </div>
      <aside class="work-aside" data-reveal>
        <div><span>{isZh ? '时间 / 场景' : 'Period / Context'}</span><strong>{project.period[lang]}</strong></div>
        <div><span>{isZh ? '方向' : 'Discipline'}</span><strong>{project.category === 'engineering' ? (isZh ? 'AI 工程' : 'AI Engineering') : (isZh ? 'AI 研究' : 'AI Research')}</strong></div>
        {project.status && <div><span>{isZh ? '状态' : 'Status'}</span><strong>{project.status[lang]}</strong></div>}
      </aside>
    </div>
    <div class="metric-grid work-metric-grid">
      {project.metrics.map((metric) => (
        <div><strong>{metric.value}</strong><span>{metric.label[lang]}</span></div>
      ))}
    </div>
  </section>

  <section class="work-flow-section">
    <div class="shell">
      <p class="mini-label">{labels.flow}</p>
      <div class="work-flow" aria-label={labels.flow}>
        {project.flow[lang].map((item, index) => (
          <>
            <span>{item}</span>
            {index < project.flow[lang].length - 1 && <i aria-hidden="true">→</i>}
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="work-body shell">
    <div class="work-body-row">
      <p class="section-index">01</p>
      <div><p class="mini-label">{labels.challenge}</p><h2>{project.challenge[lang]}</h2></div>
    </div>
    <div class="work-body-row">
      <p class="section-index">02</p>
      <div><p class="mini-label">{labels.role}</p><h2>{project.role[lang]}</h2></div>
    </div>
    <div class="work-body-row work-body-row--list">
      <p class="section-index">03</p>
      <div>
        <p class="mini-label">{labels.approach}</p>
        <ol class="approach-list">
          {project.approach[lang].map((item, index) => <li><span>0{index + 1}</span><p>{item}</p></li>)}
        </ol>
      </div>
    </div>
    <div class="work-body-row work-body-row--list">
      <p class="section-index">04</p>
      <div>
        <p class="mini-label">{labels.outcomes}</p>
        <ul class="outcome-list">
          {project.outcomes[lang].map((item) => <li><span aria-hidden="true">↗</span><p>{item}</p></li>)}
        </ul>
      </div>
    </div>
    <div class="work-body-row">
      <p class="section-index">05</p>
      <div>
        <p class="mini-label">{labels.stack}</p>
        <div class="stack-cloud">{project.stack.map((item) => <span>{item}</span>)}</div>
      </div>
    </div>
    <div class="work-body-row">
      <p class="section-index">06</p>
      <div>
        <p class="mini-label">{labels.evidence}</p>
        {project.links.length ? (
          <div class="evidence-links">
            {project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label[lang]}<span aria-hidden="true">↗</span></a>)}
          </div>
        ) : (
          <p class="enterprise-note">{labels.enterprise}</p>
        )}
      </div>
    </div>
  </section>

  <section class="next-work">
    <div class="shell">
      <p>{labels.next}</p>
      <a href={`${home}#work`}>{isZh ? '查看六个精选案例' : 'View all six selected cases'} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</main>

<Footer lang={lang} />

<script is:inline>
  document.querySelectorAll('[data-reveal]').forEach((item) => item.classList.add('is-visible'));
</script>
