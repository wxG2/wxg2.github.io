---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkDetail from '../../components/WorkDetail.astro';
import { projects, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const description = project.summary.zh;
---

<BaseLayout
  lang="zh"
  title={`${project.title.zh}｜高伟翔`}
  description={description}
  path={`/work/${project.slug}/`}
  zhPath={`/work/${project.slug}/`}
  enPath={`/en/work/${project.slug}/`}
  type="article"
>
  <WorkDetail lang="zh" project={project} />
</BaseLayout>
