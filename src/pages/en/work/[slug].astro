---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkDetail from '../../../components/WorkDetail.astro';
import { projects, type Project } from '../../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const description = project.summary.en;
---

<BaseLayout
  lang="en"
  title={`${project.title.en} | Weixiang Gao`}
  description={description}
  path={`/en/work/${project.slug}/`}
  zhPath={`/work/${project.slug}/`}
  enPath={`/en/work/${project.slug}/`}
  type="article"
>
  <WorkDetail lang="en" project={project} />
</BaseLayout>
