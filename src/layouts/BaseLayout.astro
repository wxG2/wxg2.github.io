---
import '../styles/global.css';
import type { Lang } from '../data/site';
import { profile } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path: string;
  zhPath?: string;
  enPath?: string;
  type?: 'website' | 'article';
}

const {
  lang,
  title = lang === 'zh' ? '高伟翔｜AI 应用开发者 × EEG 研究者' : 'Weixiang Gao | AI Engineer × EEG Researcher',
  description = lang === 'zh' ? profile.intro.zh : profile.intro.en,
  path,
  zhPath = '/',
  enPath = '/en/',
  type = 'website',
} = Astro.props;
const canonical = new URL(path, Astro.site);
const zhUrl = new URL(zhPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Weixiang Gao',
  alternateName: '高伟翔',
  url: new URL('/', Astro.site).toString(),
  image: new URL('/images/avatar.png', Astro.site).toString(),
  email: `mailto:${profile.email}`,
  sameAs: [profile.github],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Hangzhou Dianzi University',
  },
  knowsAbout: ['AI agents', 'Speech recognition', 'EEG', 'Diffusion models', 'Multimodal learning'],
};
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1e9" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <slot />
  </body>
</html>
